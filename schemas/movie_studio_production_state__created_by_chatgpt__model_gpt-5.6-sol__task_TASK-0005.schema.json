{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Movie Studio Production Checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "episode_id",
    "episode_status",
    "plan_revision",
    "plan_frozen",
    "spend_limit_usd_micros",
    "production",
    "movie_bible",
    "scenes",
    "shots",
    "shot_continuity_bindings",
    "generation_jobs",
    "idempotency_index",
    "authorization_index",
    "provider_request_index",
    "episode_status_history",
    "timeline",
    "master",
    "master_qc",
    "archive",
    "cleanup_authorization",
    "temporary_artifacts",
    "reference_assets"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "episode_id": {
      "type": "string"
    },
    "episode_status": {
      "enum": [
        "PLANNED",
        "IN_PRODUCTION",
        "ASSEMBLING",
        "FINAL_QC",
        "BLOCKED",
        "ARCHIVING",
        "COMPLETED"
      ],
      "description": "Intermediate offline lifecycle only; ARCHIVING and COMPLETED require a future typed timeline/archive evidence contract."
    },
    "plan_revision": {
      "type": "integer",
      "minimum": 1
    },
    "plan_frozen": {
      "type": "boolean"
    },
    "plan_revision_history": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "spend_limit_usd_micros": {
      "type": "integer",
      "const": 0
    },
    "production": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aspect_ratio",
        "target_episode_minutes",
        "local_video_inference",
        "final_storage_provider"
      ],
      "properties": {
        "aspect_ratio": {
          "const": "16:9"
        },
        "target_episode_minutes": {
          "const": 20
        },
        "local_video_inference": {
          "const": false
        },
        "final_storage_provider": {
          "const": "Google Drive"
        }
      }
    },
    "movie_bible": {
      "$ref": "#/$defs/movie_bible"
    },
    "scenes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/scene"
      }
    },
    "shots": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/shot"
      }
    },
    "generation_jobs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/generation_job"
      }
    },
    "idempotency_index": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "authorization_index": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "provider_request_index": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "provider_adapters": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/provider_adapter_registration"
      }
    },
    "shot_plans": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/shot_plan"
      }
    },
    "shot_continuity_bindings": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/shot_continuity_binding"
      }
    },
    "episode_status_history": {
      "type": "array",
      "items": {
        "enum": [
          "PLANNED",
          "IN_PRODUCTION",
          "ASSEMBLING",
          "FINAL_QC",
          "BLOCKED",
          "ARCHIVING",
          "COMPLETED"
        ]
      }
    },
    "timeline": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/timeline"
        }
      ]
    },
    "master": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/master"
        }
      ]
    },
    "master_qc": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/master_qc"
        }
      ]
    },
    "archive": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/archive"
        }
      ]
    },
    "cleanup_authorization": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/cleanup_authorization"
        }
      ]
    },
    "temporary_artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cleanup_artifact"
      }
    },
    "reference_assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference_media"
      }
    }
  },
  "$defs": {
    "string_map": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "entity_map": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/string_map"
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene_id",
        "status",
        "status_history"
      ],
      "properties": {
        "scene_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "PLANNED",
            "GENERATING",
            "REVIEW",
            "APPROVED",
            "BLOCKED"
          ]
        },
        "status_history": {
          "type": "array",
          "items": {
            "enum": [
              "PLANNED",
              "GENERATING",
              "REVIEW",
              "APPROVED",
              "BLOCKED"
            ]
          }
        }
      }
    },
    "movie_bible": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "content_digest",
        "revision_history",
        "story_rules",
        "characters",
        "voices",
        "locations",
        "costumes",
        "props",
        "continuity_facts"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "content_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "revision_history": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "story_rules": {
          "$ref": "#/$defs/string_map"
        },
        "characters": {
          "$ref": "#/$defs/entity_map"
        },
        "voices": {
          "$ref": "#/$defs/entity_map"
        },
        "locations": {
          "$ref": "#/$defs/entity_map"
        },
        "costumes": {
          "$ref": "#/$defs/entity_map"
        },
        "props": {
          "$ref": "#/$defs/entity_map"
        },
        "continuity_facts": {
          "$ref": "#/$defs/string_map"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate",
        "asset_version",
        "verdict",
        "shot_id",
        "reviewer_id",
        "reviewer_role",
        "policy_id",
        "evidence_id"
      ],
      "properties": {
        "gate": {
          "enum": [
            "VISUAL_QA",
            "CONTINUITY_QA",
            "AUDIO_QA",
            "TECHNICAL_QA"
          ]
        },
        "asset_version": {
          "type": "string",
          "minLength": 1
        },
        "verdict": {
          "enum": [
            "PENDING",
            "PASS",
            "FAIL",
            "BLOCKED"
          ]
        },
        "shot_id": {
          "type": "string",
          "minLength": 1
        },
        "reviewer_id": {
          "type": "string",
          "minLength": 1
        },
        "reviewer_role": {
          "enum": [
            "human-reviewer",
            "offline-evaluator"
          ]
        },
        "policy_id": {
          "const": "offline-shot-qa-v1"
        },
        "evidence_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shot_id",
        "scene_id",
        "asset_version",
        "has_dialogue_or_audio",
        "status",
        "reviews",
        "canonical",
        "upscale_allowed",
        "generation_epoch",
        "generation_owner_job_id"
      ],
      "properties": {
        "shot_id": {
          "type": "string",
          "minLength": 1
        },
        "scene_id": {
          "type": "string"
        },
        "asset_version": {
          "type": "string"
        },
        "has_dialogue_or_audio": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "PLANNED",
            "GENERATING",
            "GENERATED",
            "APPROVED",
            "CANONICAL",
            "REJECTED",
            "BLOCKED"
          ]
        },
        "reviews": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/review"
          }
        },
        "canonical": {
          "type": "boolean"
        },
        "upscale_allowed": {
          "type": "boolean"
        },
        "generation_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "generation_owner_job_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "attempt_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_id",
        "job_id",
        "shot_id",
        "generation_epoch",
        "attempt_number",
        "provider_id",
        "adapter_id",
        "adapter_version",
        "quote_id",
        "input_fingerprint",
        "plan_state_digest",
        "provider_request_key",
        "maximum_cost_usd_micros",
        "cloud_execution",
        "charge_cap_enforced"
      ],
      "properties": {
        "authorization_id": {
          "type": "string",
          "minLength": 1
        },
        "job_id": {
          "type": "string",
          "minLength": 1
        },
        "shot_id": {
          "type": "string",
          "minLength": 1
        },
        "generation_epoch": {
          "type": "integer",
          "minimum": 1
        },
        "attempt_number": {
          "type": "integer",
          "minimum": 1
        },
        "provider_id": {
          "type": "string",
          "minLength": 1
        },
        "adapter_id": {
          "type": "string",
          "minLength": 1
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        },
        "quote_id": {
          "type": "string",
          "minLength": 1
        },
        "input_fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "plan_state_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "provider_request_key": {
          "type": "string",
          "minLength": 1
        },
        "maximum_cost_usd_micros": {
          "type": "integer",
          "const": 0
        },
        "cloud_execution": {
          "const": true
        },
        "charge_cap_enforced": {
          "const": true
        }
      }
    },
    "generation_attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_number",
        "authorization",
        "status",
        "provider_job_id",
        "output_asset_version",
        "failure_class",
        "failure_reason"
      ],
      "properties": {
        "attempt_number": {
          "type": "integer",
          "minimum": 1
        },
        "authorization": {
          "$ref": "#/$defs/attempt_authorization"
        },
        "status": {
          "enum": [
            "AUTHORIZED",
            "RUNNING",
            "SUCCEEDED",
            "FAILED"
          ]
        },
        "provider_job_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "output_asset_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "failure_class": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "RETRYABLE_PROVIDER",
            "NON_RETRYABLE_PROVIDER",
            "POLICY",
            "INVALID_INPUT",
            null
          ]
        },
        "failure_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "generation_job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "shot_id",
        "idempotency_key",
        "input_fingerprint",
        "plan_state_digest",
        "max_attempts",
        "attempts",
        "status",
        "provider_job_id",
        "output_asset_version",
        "last_error",
        "generation_epoch",
        "attempt_history"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "minLength": 1
        },
        "shot_id": {
          "type": "string",
          "minLength": 1
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        },
        "input_fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "plan_state_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "QUEUED",
            "AUTHORIZED",
            "RUNNING",
            "SUCCEEDED",
            "RETRYABLE",
            "EXHAUSTED"
          ]
        },
        "provider_job_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "output_asset_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_error": {
          "type": [
            "string",
            "null"
          ]
        },
        "generation_epoch": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "attempt_history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/generation_attempt"
          }
        }
      }
    },
    "provider_adapter_registration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "adapter_id",
        "adapter_version",
        "capabilities",
        "cloud_execution",
        "charge_cap_enforced",
        "maximum_cost_usd_micros"
      ],
      "properties": {
        "provider_id": {
          "type": "string",
          "minLength": 1
        },
        "adapter_id": {
          "type": "string",
          "minLength": 1
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "TEXT",
              "IMAGE",
              "VIDEO",
              "AUDIO",
              "LIP_SYNC",
              "UPSCALE"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "cloud_execution": {
          "const": true
        },
        "charge_cap_enforced": {
          "const": true
        },
        "maximum_cost_usd_micros": {
          "const": 0
        }
      }
    },
    "shot_continuity_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shot_id",
        "bible_revision",
        "character_ids",
        "voice_ids",
        "location_id",
        "costume_ids",
        "prop_ids",
        "reference_asset_versions",
        "bible_digest"
      ],
      "properties": {
        "shot_id": {
          "type": "string",
          "minLength": 1
        },
        "bible_revision": {
          "type": "integer",
          "minimum": 1
        },
        "bible_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "character_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "voice_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "location_id": {
          "type": "string"
        },
        "costume_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "prop_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "reference_asset_versions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "shot_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shot_id",
        "scene_id",
        "sequence_index",
        "planned_duration_ms",
        "prompt_fingerprint",
        "has_dialogue_or_audio"
      ],
      "properties": {
        "shot_id": {
          "type": "string",
          "minLength": 1
        },
        "scene_id": {
          "type": "string",
          "minLength": 1
        },
        "sequence_index": {
          "type": "integer",
          "minimum": 0
        },
        "planned_duration_ms": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "prompt_fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "has_dialogue_or_audio": {
          "type": "boolean"
        }
      }
    },
    "timeline_clip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shot_id",
        "asset_version",
        "duration_ms"
      ],
      "properties": {
        "shot_id": {
          "type": "string",
          "minLength": 1
        },
        "asset_version": {
          "type": "string",
          "minLength": 1
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episode_id",
        "plan_revision",
        "scene_ids",
        "clips"
      ],
      "properties": {
        "episode_id": {
          "type": "string",
          "minLength": 1
        },
        "plan_revision": {
          "type": "integer",
          "minimum": 1
        },
        "scene_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "clips": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/timeline_clip"
          }
        }
      }
    },
    "master": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "master_id",
        "content_digest",
        "byte_count",
        "timeline_digest",
        "duration_ms",
        "width",
        "height"
      ],
      "properties": {
        "master_id": {
          "type": "string",
          "minLength": 1
        },
        "content_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byte_count": {
          "type": "integer",
          "minimum": 1
        },
        "timeline_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1140000,
          "maximum": 1260000
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "master_qc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "master_digest",
        "timeline_digest",
        "measured_duration_ms",
        "measured_width",
        "measured_height",
        "passed_gates",
        "reviewer_id",
        "evidence_id",
        "reviewer_role",
        "policy_id"
      ],
      "properties": {
        "master_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "timeline_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "measured_duration_ms": {
          "type": "integer",
          "minimum": 1
        },
        "measured_width": {
          "type": "integer",
          "minimum": 1
        },
        "measured_height": {
          "type": "integer",
          "minimum": 1
        },
        "passed_gates": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "AUDIO_QA",
              "CONTINUITY_QA",
              "TECHNICAL_QA"
            ]
          }
        },
        "reviewer_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "reviewer_role": {
          "enum": [
            "human-reviewer",
            "offline-evaluator"
          ]
        },
        "policy_id": {
          "const": "offline-master-qa-v1"
        }
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "master_digest",
        "readback_digest",
        "byte_count",
        "storage_provider",
        "requested_file_id",
        "readback_file_id",
        "requested_version",
        "readback_version",
        "readable",
        "verified",
        "verifier_id",
        "evidence_id",
        "offline_evidence"
      ],
      "properties": {
        "master_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "readback_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byte_count": {
          "type": "integer",
          "minimum": 1
        },
        "storage_provider": {
          "const": "Google Drive"
        },
        "requested_file_id": {
          "type": "string",
          "minLength": 1
        },
        "readback_file_id": {
          "type": "string",
          "minLength": 1
        },
        "requested_version": {
