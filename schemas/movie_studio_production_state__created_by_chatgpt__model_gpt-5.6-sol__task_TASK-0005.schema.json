{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Movie Studio Production State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "spend_limit_usd",
    "production",
    "episodes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "spend_limit_usd": {
      "type": "number",
      "const": 0
    },
    "production": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aspect_ratio",
        "target_episode_minutes",
        "local_video_inference",
        "final_storage_provider"
      ],
      "properties": {
        "aspect_ratio": {
          "const": "16:9"
        },
        "target_episode_minutes": {
          "type": "number",
          "minimum": 1,
          "default": 20
        },
        "local_video_inference": {
          "const": false
        },
        "final_storage_provider": {
          "const": "Google Drive"
        }
      }
    },
    "episodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/episode"
      }
    }
  },
  "$defs": {
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate",
        "asset_version",
        "status"
      ],
      "properties": {
        "gate": {
          "enum": [
            "VISUAL_QA",
            "CONTINUITY_QA",
            "AUDIO_QA",
            "TECHNICAL_QA",
            "TIMELINE_QA",
            "ARCHIVE_QA"
          ]
        },
        "asset_version": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "PENDING",
            "PASS",
            "FAIL",
            "BLOCKED"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shot_id",
        "status",
        "canonical",
        "reviews"
      ],
      "properties": {
        "shot_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "PLANNED",
            "GENERATING",
            "GENERATED",
            "VISUAL_QA",
            "CONTINUITY_QA",
            "AUDIO_QA",
            "APPROVED",
            "UPSCALING",
            "CANONICAL",
            "REJECTED",
            "BLOCKED"
          ]
        },
        "canonical": {
          "type": "boolean"
        },
        "reviews": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/review"
          }
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene_id",
        "status",
        "shots"
      ],
      "properties": {
        "scene_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "PLANNED",
            "GENERATING",
            "REVIEW",
            "APPROVED",
            "BLOCKED"
          ]
        },
        "shots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shot"
          }
        }
      }
    },
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episode_id",
        "status",
        "scenes",
        "final_master_verified"
      ],
      "properties": {
        "episode_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "PLANNED",
            "IN_PRODUCTION",
            "ASSEMBLING",
            "FINAL_QC",
            "ARCHIVING",
            "COMPLETED",
            "BLOCKED"
          ]
        },
        "scenes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scene"
          }
        },
        "final_master_verified": {
          "type": "boolean"
        }
      }
    }
  }
}
