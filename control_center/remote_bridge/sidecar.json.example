{
  "display_name": "Antigravity GitHub Remote Bridge",
  "description": "Antigravity 2.0 sidecar for GitHub issue supervision bridge",
  "command": "python",
  "args": [
    "control_center/remote_bridge/bridge.py"
  ],
  "restart_policy": "on_failure",
  "env": {
    "PYTHONUNBUFFERED": "1"
  }
}
