{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TASK-0003 Astra Review Result Contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[0-9]+$"
    },
    "repository": {
      "type": "string",
      "minLength": 3
    },
    "pr_number": {
      "type": "integer",
      "minimum": 1
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "reviewed_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "reviewer_context_version": {
      "type": "string",
      "minLength": 1
    },
    "reviewer_model": {
      "type": "string",
      "const": "gpt-6-astra"
    },
    "review_identity_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "result_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "APPROVED",
        "REJECTED",
        "BLOCKED_AUTH_REQUIRED",
        "BLOCKED_NO_ASTRA",
        "BLOCKED_PLAN_ALLOWANCE",
        "BLOCKED_EVIDENCE_MISMATCH",
        "BLOCKED_INVALID_VERDICT"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/finding"
      }
    },
    "approval_confirmation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exact_sha_bound": {
          "type": "boolean",
          "const": true
        },
        "exact_snapshot_bound": {
          "type": "boolean",
          "const": true
        },
        "merge_allowed": {
          "type": "boolean",
          "const": false
        },
        "auto_merge_allowed": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "exact_sha_bound",
        "exact_snapshot_bound",
        "merge_allowed",
        "auto_merge_allowed"
      ]
    },
    "correction_package": {
      "$ref": "#/definitions/correction_package"
    }
  },
  "definitions": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "severity": {
          "type": "string",
          "enum": [
            "P1",
            "P2",
            "P3"
          ]
        },
        "exact_location": {
          "type": "string",
          "minLength": 1
        },
        "exact_problem": {
          "type": "string",
          "minLength": 1
        },
        "why_it_matters": {
          "type": "string",
          "minLength": 1
        },
        "required_correction": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "implementation_guidance": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "severity",
        "exact_location",
        "exact_problem",
        "why_it_matters",
        "required_correction",
        "acceptance_criteria"
      ]
    },
    "correction_package": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "QUEUE_CORRECTION",
            "BLOCKED_RETRY_LIMIT"
          ]
        },
        "task_id": {
          "type": "string",
          "pattern": "^TASK-[0-9]+$"
        },
        "reviewed_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "current_attempt": {
          "type": "integer",
          "minimum": 0
        },
        "next_attempt": {
          "type": "integer",
          "minimum": 1
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0
        },
        "corrections": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/finding"
          }
        }
      },
      "required": [
        "action",
        "task_id",
        "reviewed_sha",
        "max_retries",
        "corrections"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "QUEUE_CORRECTION"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "next_attempt"
            ],
            "not": {
              "required": [
                "current_attempt"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "BLOCKED_RETRY_LIMIT"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "current_attempt"
            ],
            "not": {
              "required": [
                "next_attempt"
              ]
            }
          }
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "repository",
    "pr_number",
    "base_sha",
    "reviewed_sha",
    "reviewer_context_version",
    "reviewer_model",
    "review_identity_digest",
    "result_digest",
    "idempotency_key",
    "status",
    "findings"
  ],
  "oneOf": [
    {
      "properties": {
        "status": {
          "const": "APPROVED"
        },
        "findings": {
          "maxItems": 0
        }
      },
      "required": [
        "approval_confirmation"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "reason"
            ]
          },
          {
            "required": [
              "correction_package"
            ]
          }
        ]
      }
    },
    {
      "properties": {
        "status": {
          "const": "REJECTED"
        },
        "findings": {
          "minItems": 1
        }
      },
      "required": [
        "correction_package"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "reason"
            ]
          },
          {
            "required": [
              "approval_confirmation"
            ]
          }
        ]
      }
    },
    {
      "properties": {
        "status": {
          "enum": [
            "BLOCKED_AUTH_REQUIRED",
            "BLOCKED_NO_ASTRA",
            "BLOCKED_PLAN_ALLOWANCE",
            "BLOCKED_EVIDENCE_MISMATCH",
            "BLOCKED_INVALID_VERDICT"
          ]
        },
        "findings": {
          "maxItems": 0
        }
      },
      "required": [
        "reason"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "approval_confirmation"
            ]
          },
          {
            "required": [
              "correction_package"
            ]
          }
        ]
      }
    }
  ]
}
