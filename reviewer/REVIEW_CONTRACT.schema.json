{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TASK-0003 Astra Review Contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "task_id": { "type": "string", "pattern": "^TASK-[0-9]+$" },
    "repository": { "type": "string" },
    "pr_number": { "type": "integer", "minimum": 1 },
    "reviewed_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "base_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "reviewer_context_version": { "type": "string", "minLength": 1 },
    "reviewer_model": { "type": "string", "const": "gpt-6-astra" },
    "status": {
      "type": "string",
      "enum": [
        "APPROVED",
        "REJECTED",
        "BLOCKED_AUTH_REQUIRED",
        "BLOCKED_NO_ASTRA",
        "BLOCKED_PLAN_ALLOWANCE",
        "BLOCKED_EVIDENCE_MISMATCH",
        "BLOCKED_INVALID_VERDICT"
      ]
    },
    "idempotency_key": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "severity": { "type": "string", "enum": ["P1", "P2", "P3"] },
          "exact_location": { "type": "string" },
          "exact_problem": { "type": "string" },
          "why_it_matters": { "type": "string" },
          "required_correction": { "type": "string" },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "implementation_guidance": { "type": "string" }
        },
        "required": [
          "severity",
          "exact_location",
          "exact_problem",
          "why_it_matters",
          "required_correction",
          "acceptance_criteria"
        ]
      }
    },
    "approval_confirmation": {
      "type": "object",
      "properties": {
        "exact_sha_bound": { "type": "boolean", "const": true },
        "merge_allowed": { "type": "boolean", "const": false },
        "auto_merge_allowed": { "type": "boolean", "const": false }
      },
      "required": ["exact_sha_bound", "merge_allowed", "auto_merge_allowed"]
    },
    "correction_package": {
      "type": "object",
      "properties": {
        "action": { "type": "string", "enum": ["QUEUE_CORRECTION", "BLOCKED_RETRY_LIMIT"] },
        "task_id": { "type": "string" },
        "reviewed_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "next_attempt": { "type": "integer", "minimum": 1 },
        "max_retries": { "type": "integer", "minimum": 0 },
        "corrections": { "type": "array" }
      },
      "required": ["action", "task_id", "reviewed_sha", "max_retries", "corrections"]
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "reviewed_sha",
    "reviewer_model",
    "status"
  ]
}
